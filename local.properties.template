# Local Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to 'local.properties'
# 2. Add your actual API keys below
# 3. NEVER commit local.properties to version control (already in .gitignore)
#
# ============================================================================

# Android SDK Location (auto-generated by Android Studio)
# sdk.dir=/path/to/Android/sdk

# ============================================================================
# PAYMENT GATEWAY API KEYS
# ============================================================================

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_*) for development, live keys (pk_live_*) for production
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Razorpay Configuration (for India)
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use test keys for development
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# PayPal Configuration (Optional)
# Get your keys from: https://developer.paypal.com/
# Use sandbox credentials for development
# PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================

# Firebase is configured via google-services.json file
# Download from: Firebase Console > Project Settings > Your App > google-services.json
# Place the file in: app/google-services.json
#
# DO NOT add Firebase keys here - use google-services.json

# ============================================================================
# OTHER API KEYS (Optional)
# ============================================================================

# Google Maps API Key (if implementing delivery tracking)
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Analytics Keys (if using third-party analytics)
# MIXPANEL_TOKEN=your_mixpanel_token_here
# AMPLITUDE_API_KEY=your_amplitude_key_here

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Backend API URL (if using custom backend)
# API_BASE_URL=https://your-api.example.com/v1/
# API_BASE_URL=http://10.0.2.2:8080/api/  # For Android emulator localhost

# Enable debug logging
# DEBUG_MODE=true

# ============================================================================
# NOTES
# ============================================================================
# 
# Security Best Practices:
# - Never commit this file with real keys
# - Use different keys for dev/staging/production
# - Rotate keys periodically
# - Use environment-specific keys
# - Monitor key usage in dashboards
#
# Key Formats:
# - Stripe Test: pk_test_51xxxxx
# - Stripe Live: pk_live_51xxxxx  
# - Razorpay Test: rzp_test_xxxxx
# - Razorpay Live: rzp_live_xxxxx
#
