<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production configuration - Enforce HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust preinstalled CAs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug configuration - Allow localhost for testing -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android emulator localhost -->
        <domain includeSubdomains="true">10.0.3.2</domain> <!-- Genymotion emulator localhost -->
    </domain-config>

    <!-- 
    Optional: Pin specific domains for extra security
    Uncomment and configure if you have a production backend
    
    <domain-config>
        <domain includeSubdomains="true">api.arshop.com</domain>
        <pin-set expiration="2025-12-31">
            <pin digest="SHA-256">base64-encoded-pin-here</pin>
            <pin digest="SHA-256">backup-pin-here</pin>
        </pin-set>
    </domain-config>
    -->

    <!-- 
    Firebase services are automatically handled
    No need to add firebase.com or firebaseio.com here
    -->
</network-security-config>
